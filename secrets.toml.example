# Arquivo: .streamlit/secrets.toml
# Coloque este arquivo na raiz do projeto. NÃO faça commit no Git!
# Adicione ao .gitignore: .streamlit/secrets.toml

# ─── PostgreSQL (produção) ────────────────────────────────────────────────────
# Obtido no painel do Supabase, Railway, Render, Neon, etc.
DATABASE_URL = "postgresql://usuario:senha@host:5432/nome_do_banco"

# Exemplo Supabase:
# DATABASE_URL = "postgresql://postgres:SUA_SENHA@db.xxxx.supabase.co:5432/postgres"

# Exemplo Railway:
# DATABASE_URL = "postgresql://postgres:SUA_SENHA@containers-us-west-XX.railway.app:PORTA/railway"
